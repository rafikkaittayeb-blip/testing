# Copy to .env and fill in. Placeholders only; never commit real keys.
# MODE: auto = live if a key is set, otherwise replay (STUBBED); live; replay
MODE=auto
GROQ_API_KEY=your-groq-key-here
OPENROUTER_API_KEY=
# The app container uses http://searxng:8080 (set in docker-compose.yml); this is for the CLI on the host.
SEARXNG_URL=http://localhost:8080
RUNS_DIR=runs
OUTBOX_DIR=outbox
